import asyncio
import discord
import os
from discord.ext import commands

intents = discord.Intents.default()
intents.members = True          
intents.message_content = True  

class DabdobiBot(commands.Bot):
    def __init__(self):
        super().__init__(command_prefix="!", intents=intents)
        
    async def setup_hook(self):
        await self.load_extension("cogs.actions")
        await self.tree.sync()
        print("✅ تم تحميل الـ Cogs ومزامنة جميع الأوامر المائلة (/) بنجاح!")

bot = DabdobiBot()

@bot.event
async def on_ready():
    print(f"=================================")
    print(f"🤖 تم تشغيل البوت بنجاح!")
    print(f"👑 اسم البوت: {bot.user.name}")
    print(f"=================================")

# الطريقة الأكثر استقراراً لتشغيل ديسكورد على الاستضافات
if __name__ == "__main__":
    # جلب التوكن من ريندر
    TOKEN = os.getenv("DISCORD_TOKEN")
    
    if TOKEN:
        bot.run(TOKEN)
    else:
        print("❌ خطأ: لم يتم العثور على المتغير البيئي DISCORD_TOKEN!")
