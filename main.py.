import discord
from discord.ext import commands
from PIL import Image, ImageDraw, ImageSequence
import io
import requests

@bot.event
async def on_member_join(member):
    # 1. حدد ايدي الروم الذي سيرسل فيه الترحيب
    channel = bot.get_channel(1234567890) #1491147425833029672
    # 2. روابط الصور (استبدلها بروابطك المباشرة)
    BG_URL = "https://cdn.discordapp.com/attachments/1491146217260847124/1504880901501489243/c32907ac10dd46d2b94de7f37df71cfd.gif?ex=6a08990e&is=6a07478e&hm=b9e9b1a7a7afad3a0e2e81f3ae8c35dbcf6b797e409f34c0b902bfa64ce609c5&"
    OVERLAY_URL = "https://cdn.discordapp.com/attachments/1491146217260847124/1504880891795734690/b0e6c5cb36d34e3990597a4da83232b5.gif?ex=6a08990b&is=6a07478b&hm=ffa2e7f650f0cf243d245d539f36caf604ca4ada482618b8ee0dd6e93d88fb6f&"
    
    # 3. جلب صورة العضو ومعالجتها (جعلها دائرية)
    avatar_url = member.display_avatar.url
    avatar_data = requests.get(avatar_url).content
    avatar_img = Image.open(io.BytesIO(avatar_data)).convert("RGBA").resize((200, 200))
    
    # صنع قناع دائري لصورة العضو
    mask = Image.new("L", (200, 200), 0)
    draw = ImageDraw.Draw(mask)
    draw.ellipse((0, 0, 200, 200), fill=255)
    
    # 4. فتح الخلفية والطبقة الشفافة
    bg_gif = Image.open(io.BytesIO(requests.get(BG_URL).content))
    overlay_gif = Image.open(io.BytesIO(requests.get(OVERLAY_URL).content))

    frames = [] # هذه القائمة ستجمع الإطارات المدمجة

    # 5. عملية الدمج (إطار تلو الآخر)
    # سنمر على إطارات الخلفية وندمج فوقها صورة العضو ثم الأزهار
    for frame in ImageSequence.Iterator(bg_gif):
        # تجهيز الإطار الحالي من الخلفية
        base = frame.convert("RGBA")
        
        # وضع صورة العضو في المنتصف (مثلاً الإحداثيات 400, 150)
        base.paste(avatar_img, (400, 150), mask)
        
        # جلب الإطار المقابل من الأزهار المتحركة ووضعه في الأعلى
        try:
            overlay_frame = next(ImageSequence.Iterator(overlay_gif)).convert("RGBA")
            base.alpha_composite(overlay_frame) # دمج الطبقة الشفافة
        except StopIteration:
            # إذا انتهت إطارات الأزهار قبل الخلفية، نعيد تشغيل أزهار من الأول
            overlay_gif.seek(0)
            overlay_frame = overlay_gif.convert("RGBA")
            base.alpha_composite(overlay_frame)

        frames.append(base)

    # 6. حفظ النتيجة كـ GIF في الذاكرة
    output = io.BytesIO()
    frames[0].save(output, format="GIF", save_all=True, append_images=frames[1:], loop=0, duration=bg_gif.info['duration'])
    output.seek(0)

    # 7. إرسال النتيجة
    file = discord.File(fp=output, filename="welcome_dabdobi.gif")
    await channel.send(f"أهلاً بك يا {member.mention} في عالم دبدوبي المتحرك! 🌸", file=file)
